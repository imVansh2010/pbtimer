# Optional account sync. Copy this file to `.env.local` and fill both values.
#
# Dashboard → Project Settings → API:
#   VITE_SUPABASE_URL      = Project URL        (https://<ref>.supabase.co)
#   VITE_SUPABASE_ANON_KEY = anon / publishable key
#
# Both are public by design: the browser needs them, and row level security in
# Postgres is what keeps one account away from another's rows. Never put the
# service_role key in this file or anywhere in the client bundle.
#
# Without these two values the timer still works exactly as before: everything
# stays in this browser and no account UI is shown.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
